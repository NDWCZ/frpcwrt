#!/bin/sh
# k2-frpc-fetch — 把 frpc 二进制下载到 /tmp 内存盘（tmpfs）运行，不写 Flash。
# K2 是 8M Flash / 64MB RAM；frp 0.69.1 的 frpc 约 16.4MB，Flash 装不下，
# 但放内存盘绰绰有余。/tmp 是内存，重启会丢，所以每次开机由 /etc/init.d/frpc 重新拉。
#
# 下载源优先级（可用 UCI 覆盖）：
#   uci set frpc.main.bin_url='<完整 tar.gz 地址>'   # 自定义/镜像源
#   uci commit frpc
# 默认依次尝试：自定义 URL → 官方 GitHub → 几个常见 GitHub 加速镜像。
#
# 输出：$MEM_BIN（默认 /tmp/frpc），权限 755。成功退出 0，失败退出 1。

MEM_BIN=/tmp/frpc
TMP_DIR=/tmp/.frpc-fetch
FRP_VERSION=0.69.1
FRP_ARCH=mipsle
PKG="frp_${FRP_VERSION}_linux_${FRP_ARCH}"
OFFICIAL="https://github.com/fatedier/frp/releases/download/v${FRP_VERSION}/${PKG}.tar.gz"

# 缓存命中：已有可执行文件且版本标记一致就跳过下载
VERFILE=/tmp/.frpc-version
if [ -x "$MEM_BIN" ] && [ -f "$VERFILE" ] && [ "$(cat "$VERFILE" 2>/dev/null)" = "$FRP_VERSION-$FRP_ARCH" ]; then
  exit 0
fi

custom_url=$(uci -q get frpc.main.bin_url 2>/dev/null)

# 选一个可用的下载器：uclient-fetch（OpenWrt 自带）→ wget → curl
http_get() {
  url=$1; out=$2
  if command -v uclient-fetch >/dev/null 2>&1; then
    uclient-fetch -q -T 60 -O "$out" "$url" 2>/dev/null
  elif command -v wget >/dev/null 2>&1; then
    wget -q -T 60 -O "$out" "$url" 2>/dev/null
  elif command -v curl >/dev/null 2>&1; then
    curl -fsSL --max-time 600 -o "$out" "$url" 2>/dev/null
  else
    return 1
  fi
}

# 校验并就位：改名（同盘 rename 不占额外空间）+ 写版本标记
finalize() {
  chmod 755 "$MEM_BIN.tmp" 2>/dev/null
  sz=$(wc -c < "$MEM_BIN.tmp" 2>/dev/null)
  case "$sz" in ''|*[!0-9]*) return 1 ;; esac
  [ "$sz" -gt 1048576 ] || return 1
  mv "$MEM_BIN.tmp" "$MEM_BIN" 2>/dev/null || return 1
  chmod 755 "$MEM_BIN"
  printf '%s' "$FRP_VERSION-$FRP_ARCH" > "$VERFILE"
  logger -t frpc-fetch "frpc 已就绪: $MEM_BIN ($((sz / 1048576)) MB, 内存盘)"
  return 0
}

try_url() {
  url=$1
  logger -t frpc-fetch "尝试下载: $url"
  rm -f "$MEM_BIN.tmp"
  # 选下载器：wget 优先（K2 固件自带）
  DL=""
  if command -v wget >/dev/null 2>&1; then
    DL="wget -q -T 60 -O -"
  elif command -v uclient-fetch >/dev/null 2>&1; then
    DL="uclient-fetch -q -T 60 -O -"
  elif command -v curl >/dev/null 2>&1; then
    DL="curl -fsSL --max-time 600"
  fi
  [ -n "$DL" ] || return 1
  # 方案 A：边下边解（管道流式），tmpfs/RAM 峰值仅一份 frpc（~17MB）；
  # 落盘方案要压缩包 11.9MB + 解包 17.2MB 两份并存（29.1MB），贴着 28.6M tmpfs 上限
  $DL "$url" 2>/dev/null | tar -x -z -O -f - "$PKG/frpc" > "$MEM_BIN.tmp" 2>/dev/null
  finalize && return 0
  # 方案 B 兜底：先落盘再解，能兼容目录名不同的自定义包；峰值两份，仅在 A 失败时走
  rm -f "$MEM_BIN.tmp"
  rm -rf "$TMP_DIR"; mkdir -p "$TMP_DIR" || return 1
  $DL "$url" > "$TMP_DIR/pkg.tar.gz" 2>/dev/null || { rm -rf "$TMP_DIR"; return 1; }
  [ -s "$TMP_DIR/pkg.tar.gz" ] || { rm -rf "$TMP_DIR"; return 1; }
  member=$(tar -tzf "$TMP_DIR/pkg.tar.gz" 2>/dev/null | grep -E '(^|/)frpc$' | head -n 1)
  if [ -z "$member" ]; then
    rm -rf "$TMP_DIR"; return 1
  fi
  tar -x -z -O -f "$TMP_DIR/pkg.tar.gz" "$member" > "$MEM_BIN.tmp" 2>/dev/null || {
    rm -f "$MEM_BIN.tmp"; rm -rf "$TMP_DIR"; return 1
  }
  rm -rf "$TMP_DIR"
  finalize
}

# 开机时 WAN/DNS 可能未就绪，所有下载源会瞬间失败白烧一轮尝试；
# 先等网络可用（最长 60s），再开始尝试下载
wait_for_net() {
  i=0
  while [ $i -lt 30 ]; do
    if ping -c1 -W2 223.5.5.5 >/dev/null 2>&1 || nslookup github.com >/dev/null 2>&1; then
      logger -t frpc-fetch "网络已就绪（等待 $((i * 2)) 秒）"
      return 0
    fi
    sleep 2
    i=$((i + 1))
  done
  logger -t frpc-fetch "等待 60 秒后网络仍未就绪，仍尝试下载"
}

# 依次尝试各下载源
{
  wait_for_net
  [ -n "$custom_url" ] && printf '%s\n' "$custom_url"
  # 2026-11-28 实测（本地 1MB 测速）：ghfast.top 4.4s / gh-proxy.com 12.7s /
  # ghproxy.net 25s 超时。官方 GitHub 在国内经常卡数分钟，ghfast 提到官方之前，
  # 避免每次开机都先空等官方超时。ghfast 不通时才退回官方与其它镜像。
  printf '%s\n' \
    "https://ghfast.top/${OFFICIAL}" \
    "https://gh-proxy.com/${OFFICIAL}" \
    "$OFFICIAL" \
    "https://ghproxy.net/${OFFICIAL}"
} | while IFS= read -r url; do
  [ -n "$url" ] || continue
  try_url "$url" && break
done

rm -rf "$TMP_DIR"
[ -x "$MEM_BIN" ] || {
  logger -t frpc-fetch '所有下载源均失败；请用 uci set frpc.main.bin_url 指定可达地址后重试'
  exit 1
}
exit 0

#!/bin/sh /etc/rc.common
# frpc init：从 UCI /etc/config/frpc 生成 frp 0.69.x 的 TOML 配置并交给 procd 托管
# 二进制策略：优先 /usr/bin/frpc（用户自己放进固件）；
#             否则开机下载到 /tmp/frpc 内存盘运行（K2 只有 8M Flash，塞不下 16MB 的 frpc）。
START=95
STOP=10
USE_PROCD=1

FLASH_PROG=/usr/bin/frpc
MEM_PROG=/tmp/frpc
FETCH=/usr/bin/k2-frpc-fetch
CONF_DIR=/var/etc
CONF_FILE="$CONF_DIR/frpc.toml"
# 用户在面板「高级」里直接编辑的 TOML，存在则优先使用（可写多条 [[proxies]]）
CUSTOM_CONF=/etc/frpc.toml

toml_quote() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

valid_port() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
    *) [ "$1" -ge 1 ] && [ "$1" -le 65535 ] ;;
  esac
}

# 解析出本次要用的 frpc 路径；必要时触发下载（含网络未就绪时的重试）
resolve_prog() {
  if [ -x "$FLASH_PROG" ]; then
    printf '%s' "$FLASH_PROG"
    return 0
  fi
  if [ -x "$MEM_PROG" ]; then
    printf '%s' "$MEM_PROG"
    return 0
  fi
  [ -x "$FETCH" ] || return 1

  # 开机早期 WAN 可能还没拿到地址，失败后重试几次
  i=1
  while [ "$i" -le 3 ]; do
    logger -t frpc "正在下载 frpc 到内存盘（第 $i 次）"
    "$FETCH" && [ -x "$MEM_PROG" ] && { printf '%s' "$MEM_PROG"; return 0; }
    i=$((i + 1))
    [ "$i" -le 3 ] && sleep 10
  done
  return 1
}

start_service() {
  config_load frpc

  local enabled server port token name lp rp
  config_get_bool enabled main enabled 0
  [ "$enabled" -eq 1 ] || return 0

  # 高级模式：有自定义 TOML 就直接用它，支持任意多条穿透
  if [ -s "$CUSTOM_CONF" ]; then
    logger -t frpc "使用自定义配置 $CUSTOM_CONF"
    PROG=$(resolve_prog)
    [ -n "$PROG" ] && [ -x "$PROG" ] || {
      logger -t frpc 'frpc 二进制不可用'
      return 1
    }
    procd_open_instance
    procd_set_param command "$PROG" -c "$CUSTOM_CONF"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$CUSTOM_CONF"
    procd_close_instance
    return 0
  fi

  config_get server main server
  config_get port main port 7000
  config_get token main token
  config_get name main name web
  config_get lp main local_port 80
  config_get rp main remote_port 10080

  [ -n "$server" ] || { logger -t frpc '未配置服务器地址'; return 1; }
  valid_port "$port" || port=7000
  valid_port "$lp" || lp=80
  valid_port "$rp" || rp=10080
  [ -n "$name" ] || name=web

  PROG=$(resolve_prog)
  [ -n "$PROG" ] && [ -x "$PROG" ] || {
    logger -t frpc 'frpc 二进制不可用：可放 /usr/bin/frpc，或用 uci set frpc.main.bin_url 指定下载源'
    return 1
  }

  mkdir -p "$CONF_DIR"
  {
    printf 'serverAddr = "%s"\n' "$(toml_quote "$server")"
    printf 'serverPort = %s\n' "$port"
    if [ -n "$token" ]; then
      printf 'auth.method = "token"\n'
      printf 'auth.token = "%s"\n' "$(toml_quote "$token")"
    fi
    printf 'log.level = "info"\n'
    printf '\n'
    printf '[[proxies]]\n'
    printf 'name = "%s"\n' "$(toml_quote "$name")"
    printf 'type = "tcp"\n'
    printf 'localIP = "127.0.0.1"\n'
    printf 'localPort = %s\n' "$lp"
    printf 'remotePort = %s\n' "$rp"
  } > "$CONF_FILE"

  procd_open_instance
  procd_set_param command "$PROG" -c "$CONF_FILE"
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param file "$CONF_FILE"
  procd_close_instance
}

stop_service() {
  killall frpc >/dev/null 2>&1
}

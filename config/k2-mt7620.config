#
# OpenWrt 21.02.7 / ramips-mt7620 / 斐讯 K2
# 默认配置：基础系统 + uhttpd + dropbear + iw + 2.4G WiFi + IPv6，无 LuCI
# 未列出的选项在 make defconfig 时自动用默认值补齐。
# 需要极限压体积时改用 config/k2-mt7620-min.config（无 IPv6）。
#
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_phicomm_k2=y
# CONFIG_TARGET_MULTI_PROFILE is not set
# CONFIG_TARGET_ALL_PROFILES is not set
# CONFIG_TARGET_PER_DEVICE_ROOTFS is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# --- 面板与登录所需 ---
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_netifd=y

# --- K2 2.4GHz（DEVICE_PACKAGES 里也会自动带 kmod-mt76x2）---
CONFIG_PACKAGE_wpad-basic-wolfssl=y
CONFIG_PACKAGE_kmod-mt76x2=y

# --- IPv6：WAN DHCPv6-PD + LAN RA/DHCPv6 + 防火墙 ---
CONFIG_IPV6=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_kmod-ipv6=y
CONFIG_PACKAGE_kmod-ip6tables=y

# --- 坚决不要 LuCI ---
# CONFIG_PACKAGE_luci is not set
# CONFIG_PACKAGE_luci-base is not set
# CONFIG_PACKAGE_luci-mod-status is not set
# CONFIG_PACKAGE_luci-theme-bootstrap is not set

# --- 保留 opkg，方便刷机后补装 frpc 二进制（也可直接放进 files/usr/bin/）---
CONFIG_PACKAGE_opkg=y
# CONFIG_PACKAGE_vim is not set
# CONFIG_PACKAGE_nano is not set
